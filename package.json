{
  "name": "prooftrace",
  "version": "0.1.0",
  "description": "Local-first proof bundle generator for agent-built changes.",
  "type": "module",
  "bin": {
    "prooftrace": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "fixtures",
    "scripts",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "npm run build && test -f ./dist/cli.js && test -f ./dist/index.js && npm pack --dry-run",
    "release:config": "node scripts/validate-release.mjs",
    "release:dry-run": "npm run release:config && npm pack --dry-run",
    "release:check": "npm run check && npm test && node --test scripts/*.test.mjs && npm run smoke && npm run package:smoke",
    "prepack": "npm run build"
  },
  "keywords": [
    "agent",
    "cli",
    "local-first",
    "proof",
    "testing",
    "verification"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/prooftrace.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/prooftrace/issues"
  },
  "homepage": "https://github.com/rogerchappel/prooftrace#readme"
}
